# Railway Environment Variables Configuration
# Copy these to your Railway service environment variables

# CRITICAL - REQUIRED FOR PRODUCTION
NODE_ENV=production
JWT_SECRET=your-super-secure-jwt-secret-min-32-characters

# Database - Railway will provide this automatically if you add MongoDB service
DATABASE_URL=mongodb://localhost:27017/pilates-studio
# OR
MONGODB_URI=mongodb://localhost:27017/pilates-studio

# MercadoPago - REQUIRED for payments
MP_ACCESS_TOKEN=your-mercadopago-production-access-token

# Railway automatically provides these - DON'T SET MANUALLY
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app
# RAILWAY_ENVIRONMENT_NAME=production
# PORT=5000 (Railway sets this automatically)

# Optional - Override URL configuration
# BASE_URL=https://your-custom-domain.com
# FRONTEND_URL=https://your-custom-domain.com

# SSL Configuration (only if using custom domain with custom SSL)
# SSL_KEY_PATH=/path/to/ssl/private.key
# SSL_CERT_PATH=/path/to/ssl/certificate.crt